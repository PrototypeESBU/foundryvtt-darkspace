<form class="{{cssClass}} shadowdark flexcol" autocomplete="off">
    {{> items/item-header placeholder="Weapon Name"}}

    <section class="sheet-body flexcol ds-item-body">
        <div class="ds-form-grid-2">
            <div class="form-group">
                <label>Damage Type</label>
                <select name="system.damageType">
                    <option value="Melee"      {{#if (eq system.damageType "Melee")}}selected{{/if}}>Melee</option>
                    <option value="Projectile" {{#if (eq system.damageType "Projectile")}}selected{{/if}}>Projectile</option>
                    <option value="Energy"     {{#if (eq system.damageType "Energy")}}selected{{/if}}>Energy</option>
                </select>
            </div>
            <div class="form-group">
                <label>Category</label>
                <select name="system.size">
                    <option value=""      {{#if (eq system.size "")}}selected{{/if}}>&mdash;</option>
                    <option value="Light" {{#if (eq system.size "Light")}}selected{{/if}}>Light</option>
                    <option value="Medium" {{#if (eq system.size "Medium")}}selected{{/if}}>Medium</option>
                    <option value="Heavy" {{#if (eq system.size "Heavy")}}selected{{/if}}>Heavy</option>
                </select>
            </div>
            <div class="form-group">
                <label>Weapon Type</label>
                <select name="system.type">
                    {{selectOptions config.WEAPON_TYPES selected=system.type localize=false}}
                </select>
            </div>
            <div class="form-group">
                <label>Range</label>
                <select name="system.range">
                    {{selectOptions config.RANGES selected=system.range localize=false}}
                </select>
            </div>
            <div class="form-group">
                <label>Handedness</label>
                <select name="system.handedness">
                    <option value=""   {{#if (eq system.handedness "")}}selected{{/if}}>&mdash;</option>
                    <option value="1h" {{#if (eq system.handedness "1h")}}selected{{/if}}>1H</option>
                    <option value="2h" {{#if (eq system.handedness "2h")}}selected{{/if}}>2H</option>
                </select>
            </div>
            <div class="form-group">
                <label>Damage (1H)</label>
                <input name="system.damage.oneHanded" type="text" value="{{system.damage.oneHanded}}" placeholder="1d8" />
            </div>
            <div class="form-group">
                <label>Damage (2H)</label>
                <input name="system.damage.twoHanded" type="text" value="{{system.damage.twoHanded}}" placeholder="1d10" />
            </div>
            <div class="form-group">
                <label>Ammo Class</label>
                <select name="system.ammoClass">
                    <option value="">&mdash;</option>
                    {{selectOptions ammunition selected=system.ammoClass localize=false}}
                </select>
            </div>
        </div>

        <div class="form-group">
            <label>
                Properties
                <a class="item-selector"
                    data-item-type="weapon"
                    data-select-type="itemProperty"
                    for="system.properties"
                ><i class="fas fa-pen-to-square"></i></a>
            </label>
            <ul class="tags">
                {{#each propertyItems}}
                <li class="tag tag_primary" data-tooltip="{{this.system.description}}">{{this.name}}</li>
                {{/each}}
            </ul>
        </div>

        <div class="form-group">
            <label>Description</label>
            {{editor system.description target="system.description" button=true owner=owner editable=editable engine="prosemirror" collaborate=false}}
        </div>
    </section>
</form>
