<form class="{{cssClass}} shadowdark flexcol" autocomplete="off">
    {{> items/item-header placeholder="Species Name"}}

    <section class="sheet-body flexcol ds-item-body">
        <fieldset>
            <legend>Ability Bonuses</legend>
            <div class="ds-form-grid-6 ds-text-center">
                {{#each (array "str" "int" "dex" "wis" "con" "cha") as |ability|}}
                <div>
                    <label class="ds-label-small ds-text-upper">{{ability}}</label>
                    <input name="system.abilityBonuses.{{ability}}" type="number"
                        value="{{lookup ../system.abilityBonuses ability}}" class="ds-text-center" />
                </div>
                {{/each}}
            </div>
        </fieldset>

        <div class="form-group">
            <label>Traits</label>
            {{editor system.traits target="system.traits" button=true owner=owner editable=editable engine="prosemirror" collaborate=false}}
        </div>

        <div class="form-group">
            <label>Description</label>
            {{editor system.description target="system.description" button=true owner=owner editable=editable engine="prosemirror" collaborate=false}}
        </div>
    </section>
</form>
