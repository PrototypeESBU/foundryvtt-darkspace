<form class="{{cssClass}} shadowdark flexcol" autocomplete="off">
    {{> items/item-header placeholder="Species Name"}}

    <section class="sheet-body flexcol ds-item-body">
        <fieldset>
            <legend>Talents</legend>
            {{> items/_partials/choice-selector config=talentsConfig editable=editable}}
            <div class="form-group">
                <label>Talent Choices</label>
                {{numberInput item.system.talentChoiceCount name="system.talentChoiceCount" placeholder="0"}}
            </div>
        </fieldset>

        <div class="form-group">
            <label>Description</label>
            {{editor system.description target="system.description" button=true owner=owner editable=editable engine="prosemirror" collaborate=false}}
        </div>
    </section>
</form>
