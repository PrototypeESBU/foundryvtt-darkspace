<form class="{{cssClass}} shadowdark flexcol" autocomplete="off">
    {{> items/item-header placeholder="Weapon Name"}}

    <section class="sheet-body flexcol ds-item-body">
        <div class="ds-form-grid-2">
            <div class="form-group">
                <label>Damage Type</label>
                <select name="system.damageType">
                    <option value="Projectile" {{#if (eq system.damageType "Projectile")}}selected{{/if}}>Projectile</option>
                    <option value="Energy"     {{#if (eq system.damageType "Energy")}}selected{{/if}}>Energy</option>
                </select>
            </div>
            <div class="form-group">
                <label>Damage</label>
                <input name="system.damage" type="text" value="{{system.damage}}" placeholder="1d6" />
            </div>
            <div class="form-group">
                <label>Range</label>
                <input name="system.range" type="text" value="{{system.range}}" placeholder="Close" />
            </div>
            <div class="form-group">
                <label>Energy Cost</label>
                <input name="system.energyCost" type="number" value="{{system.energyCost}}" />
            </div>
        </div>

        <div class="form-group">
            <label>Description</label>
            {{editor system.description target="system.description" button=true owner=owner editable=editable engine="prosemirror" collaborate=false}}
        </div>
    </section>
</form>
