
    {{#each system.abilities as |ability id|}}
        <div class="DS-box">
            <div class="header">
                <label>
                    <a
                        data-action="roll-ability-check"
                        data-ability="{{id}}"
                    >
                        {{localize (concat "SHADOWDARK.ability_" id)}}
                    </a>
                </label>
                <span></span>
            </div>
            <div class="content centered larger grid-3-columns ds-stat-value">
                {{#if ../editing}}
                    <input
                        name="{{concat "system.abilities." id ".value"}}"
                        type="number"
                        value="{{ability.value}}"
                        placeholder="10"
                    >
                {{else}}
                    <span>{{ability.value}}</span>
                {{/if}}
                <span class="ds-stat-sep">/</span>
                <span>{{numberFormat ability.mod decimals=0 sign=true}}</span>
            </div>
        </div>
    {{/each}}

