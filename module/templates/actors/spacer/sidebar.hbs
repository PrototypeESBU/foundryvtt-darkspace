<div class="ds-spacer-sidebar">
    <!-- Col 1: Stats & Attacks (270px fixed) -->
    <div class="ds-sheet-col ds-col-fixed-270">
        <div class="centered">
            <h1><i>D</i>ark<i>S</i>pace</h1>
            <h2>Spacer Sheet</h2>
        </div>
        <div class="DS-wrapper grid-2-columns">
            {{> stats }}
        </div>
        {{#> ui/ds-box header-label="Attacks" class="ds-sidebar-attacks"}}
            <div class="ds-attacks-col">
                {{> attacks }}
            </div>
        {{/ui/ds-box}}
    </div>

    <!-- Col 2: Spacer Identity (200px fixed) -->
    <div class="ds-sheet-col ds-col-fixed-200">
        <div class="ds-name-box">
                <textarea
                    class="ds-name-input"
                    name="name"
                    placeholder="Name"
                    rows="1"
                >{{actor.name}}</textarea>
           

            <img
                class="ds-portrait"
                src="{{ actor.img }}"
                data-action="editImage"
                data-edit="img"
                data-tooltip="{{ actor.name }}"
            />
            {{!-- Read-only: the editable copies live in the Details tab, and two
                  inputs sharing a name would collide on submit --}}
            <div class="ds-spacer-level">
                <div>
                    <span>{{localize "SHADOWDARK.sheet.actor.level"}} {{system.level.value}}</span>
                    <span>{{species.name}}</span>
                </div>
                <div>
                    <span>{{archetype.name}}</span>
                    <span>{{background.name}}</span>
                </div>
            </div>
        </div>

        <div class="ds-sidebar-hp-ac">
            {{> hp }}
            {{> actors/player/abilities/ac }}
        </div>

        <div class="ds-sidebar-luck-slots">
            {{> actors/player/abilities/luck }}
            <div class="DS-box">
                <div class="header">
                    <label>{{localize "DARKSPACE.sheet.spacer.gear.slots"}}</label>
                    <span></span>
                </div>
                <div class="content">
                    <div class="value-grid{{#if slotsOverCapacity}} ds-over-capacity{{/if}}">
                        <div>{{slots.total}}</div>
                        <div>/</div>
                        <div>{{gearSlots}}</div>
                    </div>
                </div>
            </div>
        </div>

        {{#> ui/ds-box header-label="Ship" class="ds-sidebar-shipname"}}
            {{#if shipName}}
                <a data-action="ship-open" data-uuid="{{shipId}}">{{shipName}}</a>
                {{#if shipRoles.length}}
                <div class="ds-spacer-roles">
                    {{#each shipRoles}}<span class="ds-role-tag">{{this}}</span>{{/each}}
                </div>
                {{/if}}
            {{else}}
                <span class="ds-unset">Unassigned</span>
            {{/if}}
        {{/ui/ds-box}}

        {{#> ui/ds-box header-label="Credits"}}
            <div class="ds-credits-row">
                <input class="ds-credits-input" type="text" data-value="{{system.coins.gp}}" value="{{system.coins.gp}}" />
                <a data-action="credits-to-ship"
                    data-tooltip="DARKSPACE.sheet.spacer.credits.sendTooltip"
                ><i class="fa-solid fa-arrow-right"></i><i class="fa-solid fa-shuttle-space"></i></a>
            </div>
        {{/ui/ds-box}}
    </div>
</div>
