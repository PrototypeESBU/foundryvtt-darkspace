<section class="tab tab-details {{tab.cssClass}}" data-group="primary" data-tab="details">
    <div class="ds-details-grid">
        <div class="ds-details-stats-row">
            {{#> ui/ds-box header-label="Rep"}}
                <input
                    name="system.renown"
                    type="number"
                    value="{{ system.renown }}"
                    placeholder="0"
                />
            {{/ui/ds-box}}
            {{> level }}
            {{> actors/player/details/xp }}
        </div>
        <div class="ds-details-fields">
            {{#> ui/ds-box header-label="Archetype"}}
                {{#if archetype}}
                    <a data-action="item-edit" data-item-id="{{archetype.id}}">{{archetype.name}}</a>
                {{else}}
                    <span class="ds-unset">—</span>
                {{/if}}
            {{/ui/ds-box}}

            {{#> ui/ds-box header-label="Background"}}
                {{#if background}}
                    <a data-action="item-edit" data-item-id="{{background.id}}">{{background.name}}</a>
                {{else}}
                    <span class="ds-unset">—</span>
                {{/if}}
            {{/ui/ds-box}}

            {{#> ui/ds-box header-label="Species"}}
                {{#if species}}
                    <a data-action="item-edit" data-item-id="{{species.id}}">{{species.name}}</a>
                {{else}}
                    <span class="ds-unset">—</span>
                {{/if}}
            {{/ui/ds-box}}

            {{#> ui/ds-box header-label="Motivation"}}
                <select name="system.motivation">
                    <option value="">—</option>
                    {{#each motivationChoices}}
                        <option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>
                    {{/each}}
                </select>
            {{/ui/ds-box}}

            {{#> ui/ds-box header-label="Ship Role"}}
                Ship Role
            {{/ui/ds-box}}

            <div class="ds-details-full-width">
                {{> actors/player/details/languages }}
            </div>
        </div>
    </div>
</section>
