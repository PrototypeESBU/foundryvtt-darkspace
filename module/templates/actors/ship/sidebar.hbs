<div class="ds-ship-sidebar">
    <!-- Col 1: Stats & Weapons (270px fixed) -->
    <div class="ds-sheet-col ds-col-fixed-270">
        <div class="centered">
            <h1><i>D</i>ark<i>S</i>pace</h1>
            <h2>Ship Sheet</h2>
        </div>
        <div class="DS-wrapper grid-2-columns">
            {{> stats }}
        </div>
        {{#> ui/ds-box header-label="Weapons" class="ds-sidebar-weapons"}}
            {{#*inline "ds-box-header-span"}}
                {{#if owner}}
                <a data-action="item-create" data-item-type="darkspace.Weapon"><i class="fas fa-plus"></i></a>
                {{/if}}
            {{/inline}}
            {{#each weapons as |item|}}
            <div class="ds-weapon-row item" data-item-id="{{item.id}}">
                <a data-action="item-edit" data-item-id="{{item.id}}"><b class="item-name">{{item.name}}</b></a>
                <span class="item-subtext">{{formatSubtext item.system.subtext}}</span>
            </div>
            {{/each}}
        {{/ui/ds-box}}
    </div>

    <!-- Col 2: Ship Identity (200px fixed) -->
    <div class="ds-sheet-col ds-col-fixed-200">
        {{#> ui/ds-box header-label="Name"}}
            <input name="name" type="text" value="{{ actor.name }}" placeholder="Ship Name" />
        {{/ui/ds-box}}

        <img
            class="ds-portrait"
            src="{{ actor.img }}"
            data-action="editImage"
            data-edit="img"
            data-tooltip="{{ actor.name }}"
        />

        {{#> ui/ds-box header-label="Class"}}
            {{#if shipClass}}
                <a data-action="item-edit" data-item-id="{{shipClass.id}}">{{shipClass.name}}</a>
            {{else}}
                <span class="ds-unset">Drop Ship Class here</span>
            {{/if}}
        {{/ui/ds-box}}

        {{#> ui/ds-box header-label=(localize "DARKSPACE.sheet.ship.level.label") content-class="ds-ship-level"}}
            {{#if editing}}
                <input name="system.level.value" type="number" value="{{system.level.value}}" min="0" />
            {{else}}
                <span class="ds-ship-level-value">{{system.level.value}}</span>
            {{/if}}
            <span
                class="ds-crew-level"
                data-tooltip="DARKSPACE.sheet.ship.level.crewTooltip"
            >{{localize "DARKSPACE.sheet.ship.level.crewShort"}} {{crewLevel}}</span>
            {{#if owner}}
                {{#if levelUp}}
                    <a
                        class="fa-solid fa-arrow-up fa-beat ds-level-up"
                        data-action="level-up"
                        data-tooltip="DARKSPACE.sheet.ship.level.levelUpTooltip"
                    ></a>
                {{/if}}
            {{/if}}
        {{/ui/ds-box}}

        <div class="ds-sidebar-hp-ac">
            {{> hp }}
            {{#> ui/ds-box header-label="AC" content-class="ds-ac-row"}}
                <span data-tooltip="DARKSPACE.sheet.ship.ac.projectileTooltip"
                >{{localize "DARKSPACE.sheet.ship.ac.projectileShort"}} {{acProjectile}}</span>
                <span data-tooltip="DARKSPACE.sheet.ship.ac.energyTooltip"
                >{{localize "DARKSPACE.sheet.ship.ac.energyShort"}} {{acEnergy}}</span>
            {{/ui/ds-box}}
        </div>

        {{#> ui/ds-box header-label="Cargo" content-class="ds-cargo-total"}}
            <span>{{system.cargo.value}}</span>
            <span>/</span>
            <span>{{system.cargo.max}}</span>
        {{/ui/ds-box}}

        {{#> ui/ds-box header-label="Credits"}}
            <div class="ds-credits-row">
                <input class="ds-credits-input" type="text" data-value="{{system.coins.gp}}" value="{{system.coins.gp}}" />
                <a data-action="credits-to-crew"
                    data-tooltip="DARKSPACE.sheet.ship.credits.sendTooltip"
                ><i class="fa-solid fa-arrow-right"></i><i class="fa-solid fa-people-group"></i></a>
            </div>
        {{/ui/ds-box}}
    </div>
</div>
