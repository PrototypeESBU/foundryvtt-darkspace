<section class="tab tab-crew {{tab.cssClass}}" data-group="primary" data-tab="crew">
    <div class="ds-crew-tab-layout">

        <!-- Left: Crew Roster -->
        <div class="ds-crew-pane">
            {{#> ui/ds-box header-label="Crew Roster"}}
                {{#each crew as |member|}}
                <div class="ds-crew-card" data-uuid="{{member.uuid}}">
                    <img class="ds-crew-portrait" src="{{member.img}}" alt="{{member.name}}" data-action="crew-open" title="Open sheet" />
                    <div class="ds-crew-info">
                        <a class="ds-crew-name" data-action="crew-open">{{member.name}}</a>
                        <span class="ds-crew-stats">Lvl {{member.level}} · {{member.hp.value}}/{{member.hp.max}} HP</span>
                        {{#if member.archetype}}<span class="ds-crew-identity">{{member.archetype}}</span>{{/if}}
                        {{#if member.background}}<span class="ds-crew-identity">{{member.background}}</span>{{/if}}
                    </div>
                </div>
                {{/each}}
                {{#unless crew.length}}
                <span class="ds-unset">Drop a Spacer actor here to add crew</span>
                {{/unless}}
            {{/ui/ds-box}}
        </div>

        <!-- Right: Ship Roles -->
        <div class="ds-roles-pane">
            {{#> ui/ds-box header-label="Ship Roles"}}
                {{#*inline "ds-box-header-span"}}
                    {{#if owner}}
                    <a data-action="item-create" data-item-type="darkspace.ShipRole" title="Add custom role"><i class="fas fa-plus"></i></a>
                    {{/if}}
                {{/inline}}
                {{#each roles as |assignment|}}
                <fieldset class="ds-role-row draggable" data-role-uuid="{{assignment.roleUuid}}" data-item-id="{{assignment.roleId}}">
                    <legend><a class="ds-role-name" data-action="item-edit" data-item-id="{{assignment.roleId}}">{{assignment.roleName}}</a></legend>
                    {{#if ../owner}}
                    <select class="ds-role-spacer-select" data-action="role-spacer-change" data-role-uuid="{{assignment.roleUuid}}">
                        <option value="">—</option>
                        {{#each ../crew as |member|}}
                        <option value="{{member.uuid}}" {{#if (eq member.uuid assignment.spacerUuid)}}selected{{/if}}>{{member.name}}</option>
                        {{/each}}
                    </select>
                    {{else}}
                    <span class="ds-role-assignee">{{assignment.spacerName}}</span>
                    {{/if}}
                </fieldset>
                {{/each}}
                {{#unless roles.length}}
                <span class="ds-unset">Drop a Ship Role here</span>
                {{/unless}}
                {{#if gunnerRoles.length}}
                <hr class="ds-role-divider" />
                {{#each gunnerRoles as |assignment|}}
                <fieldset class="ds-role-row ds-gunner-role" data-role-uuid="{{assignment.roleUuid}}">
                    <legend><span class="ds-role-name">{{assignment.roleName}}</span></legend>
                    {{#if ../owner}}
                    <select class="ds-role-spacer-select" data-action="role-spacer-change" data-role-uuid="{{assignment.roleUuid}}">
                        <option value="">—</option>
                        {{#each ../crew as |member|}}
                        <option value="{{member.uuid}}" {{#if (eq member.uuid assignment.spacerUuid)}}selected{{/if}}>{{member.name}}</option>
                        {{/each}}
                    </select>
                    {{else}}
                    <span class="ds-role-assignee">{{assignment.spacerName}}</span>
                    {{/if}}
                </fieldset>
                {{/each}}
                {{/if}}
            {{/ui/ds-box}}
        </div>

    </div>
</section>
